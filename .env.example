APP_NAME="Public Bug Reporting"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Public address of the app. QR codes point here, so use an address phones can reach
# (LAN IP such as http://192.168.1.50:8080 or a domain) when presenting.
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Bangkok

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=bug_reporting
DB_USERNAME=laravel
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production (HTTPS): set to true so the session cookie is only sent over HTTPS.
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

FILESYSTEM_DISK=public

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback

# Comma-separated Google account emails that may sign in as Admin.
ADMIN_EMAILS=admin@example.com

# Docker Compose host ports (defaults: 8080, 5432, 5173). If you change APP_PORT, change
# APP_URL and GOOGLE_REDIRECT_URI to match. HMR_HOST is where the browser loads Vite dev
# assets from; use the machine's LAN IP to test from a phone.
# APP_PORT=8080
# FORWARD_DB_PORT=5432
# DEV_SERVER_PORT=5173
# HMR_HOST=localhost

# Behind a reverse proxy that terminates HTTPS, e.g. TRUSTED_PROXIES=*
# TRUSTED_PROXIES=

# Public bug reports allowed per IP per window (default 5 per 10 minutes). Docker Desktop
# shows all visitors with one gateway IP, so raise this when presenting from a laptop.
# BUG_REPORT_RATE_LIMIT=5
# BUG_REPORT_RATE_LIMIT_MINUTES=10

VITE_APP_NAME="${APP_NAME}"
